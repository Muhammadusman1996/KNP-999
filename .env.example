# Set this to the deployed HTTPS origin before building the Android APK.
# Example: https://your-api-domain.example
VITE_API_BASE_URL=

# NexusGGR credentials (server only; never put these in frontend code)
NEXUSGGR_ENDPOINT=https://api.nexusggr.com
NEXUSGGR_AGENT_CODE=
NEXUSGGR_AGENT_TOKEN=
NEXUSGGR_TIMEOUT_MS=15000
