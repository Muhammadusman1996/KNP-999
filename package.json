    "android:build:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "vite": "^6.1.0",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/android": "^7.4.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "@capacitor/core": "^7.4.3"
  }
}
