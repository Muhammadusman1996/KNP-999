rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'REPLACE_WITH_ADMIN_EMAIL'; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // All balance/profile writes are server-side Cloud Functions only.
      allow create, update, delete: if false;
    }
    match /phoneIndex/{phone} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /walletTransactions/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /walletSettlements/{id} { allow read, write: if false; }
  }
}
